{
  "name": "vue-earth-board",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server:dev": "tsx watch server/index.ts",
    "server:start": "tsx server/index.ts",
    "build": "vue-tsc -b && tsc -p server/tsconfig.json && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:size": "node scripts/check-budget.mjs"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "^9",
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/geo-layers": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/mapbox": "^9.4.0",
    "@element-plus/icons-vue": "^2.3.2",
    "@turf/distance": "^7.4.0",
    "@turf/great-circle": "^7.4.0",
    "@types/geojson": "^7946.0.16",
    "cors": "^2.8.6",
    "deck.gl": "^9.4.0",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.7",
    "express": "^5.3.0",
    "maplibre-gl": "^5.24.0",
    "vue": "^3.5.42",
    "vue-router": "^5.4.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.11"
  }
}
